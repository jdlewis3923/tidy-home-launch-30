{
  "name": "Tidy Home",
  "short_name": "Tidy Home",
  "description": "Your visits, plan and billing — all handled.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0070C2",
  "theme_color": "#0070C2",
  "icons": [
    { "src": "/home-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/home-icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/home-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/home-apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
